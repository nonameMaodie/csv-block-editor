{
  "name": "csv-block-editor",
  "displayName": "CSV Block Editor For Survivalcraft",
  "description": "Spreadsheet editor for Survivalcraft mod development. Edit semicolon-separated CSV/TXT block data files in a table view with Chinese field mapping, data type annotations, column resizing, and seamless toggle between text and table modes.",
  "version": "0.6.0",
  "publisher": "nonameMaodie",
  "license": "MIT",
  "icon": "icon256.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nonameMaodie/csv-block-editor"
  },
  "bugs": {
    "url": "https://github.com/nonameMaodie/csv-block-editor/issues"
  },
  "homepage": "https://github.com/nonameMaodie/csv-block-editor",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "csv",
    "table",
    "spreadsheet",
    "editor",
    "semicolon",
    "data",
    "survivalcraft",
    "sc",
    "生存战争"
  ],
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "csvBlockEditor.toggleTableView",
        "title": "CSV Block Editor: Toggle Table View",
        "icon": "$(table)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "csvBlockEditor.toggleTableView",
          "when": "resourceExtname == .csv || resourceExtname == .txt || csvBlockEditor.tableViewActive",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "package":"npx vsce package",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}